# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Netlify scheduled function only (netlify/functions/supabase-keep-alive.ts)
SUPABASE_URL=

# App
NEXT_PUBLIC_SITE_URL=
# Bearer token required by app/api/keep-alive/route.ts
CRON_SECRET=

# PIX
PIX_KEY=
# Optional — cpf/cnpj/phone/email/evp. Only needed to disambiguate an
# 11-digit key, which is otherwise assumed to be a CPF.
PIX_KEY_TYPE=
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=

# Card payments — Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Card payments — PagBank
PAGBANK_TOKEN=
# Optional — sandbox/production, defaults to sandbox
PAGBANK_ENVIRONMENT=

# Optional — mercado_pago/pagbank, defaults to mercado_pago. Picks which
# provider NEW checkouts are created with; both providers' webhooks stay live
# regardless of this flag.
CARD_PAYMENT_PROVIDER=
# Optional — set to 'true' to enable the card payment option at all. Also
# gated behind a minimum amount (MIN_CARD_PAYMENT_AMOUNT in src/lib/constants.ts).
ENABLE_CARD_PAYMENT_TYPE=

# Email (Gmail SMTP + OAuth2, not plain credentials)
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional
EMAIL_FROM=
EMAIL_REPLY_TO=

# Telegram admin alerts for new RSVP requests — optional, both must be set
# together or the notification service falls back to a no-op that only logs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
